---
import ZementLogo from '@zement/design-tokens/brand/zement-logo.svg';
import Arrow from '../ui/Arrow.astro';
import { legalPath } from '../../lib/legal';
import { localePath, t, type Locale } from '../../i18n/ui';
import { shopUrl } from '../../lib/shop';
import { systemsIndexPath } from '../../lib/systems';
import consentStrings from '@zement/consent/strings.json';
import { company } from '../../data/company';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const year = new Date().getFullYear();
const legalLinks = [
  { href: legalPath(locale, 'notice'), label: t(locale, 'footer.legal') },
  { href: legalPath(locale, 'privacy'), label: t(locale, 'footer.privacy') },
  { href: legalPath(locale, 'cookies'), label: t(locale, 'footer.cookies') },
  { href: legalPath(locale, 'terms'), label: t(locale, 'footer.terms') },
  // Reabre el aviso de cookies (packages/consent escucha los enlaces a «#zm-cookies»).
  { href: '#zm-cookies', label: consentStrings[locale].footerLink },
];
// Contacto directo siempre a la vista: correo y teléfono de data/company.ts (fuente única).
const contactLinks = [
  { href: `mailto:${company.email}`, label: company.email, isEmail: true },
  { href: `tel:${company.phone.replace(/\s/g, '')}`, label: company.phone, isEmail: false },
];
const links = [
  { href: systemsIndexPath(locale), label: t(locale, 'nav.system') },
  { href: localePath(locale, '/#profesionales'), label: t(locale, 'nav.professionals') },
  { href: localePath(locale, '/#proyecto'), label: t(locale, 'nav.project') },
  { href: localePath(locale, '/#contacto'), label: t(locale, 'nav.contact') },
  { href: shopUrl(locale), label: t(locale, 'nav.shop'), isExternal: true },
];
---

<!-- Con la barra de la tienda visible (móvil), deja sitio para que no tape los enlaces legales -->
<footer class="border-line-dark bg-night text-sand overflow-hidden border-t [.has-shop-bar_&]:pb-14 lg:[.has-shop-bar_&]:pb-0">
  <!--
    Pie compacto: logotipo grande a la izquierda y, a su lado, menú y contacto alineados abajo.
    El lema de marca pasa a la barra inferior, junto al ©.
  -->
  <div class="container-site grid gap-6 pt-8 pb-5 lg:grid-cols-12 lg:items-end lg:gap-10">
    <div
      class="text-paper select-none lg:col-span-7"
      data-reveal
    >
      <ZementLogo
        class="block h-auto w-full"
        aria-hidden="true"
      />
    </div>
    <div class="label grid gap-3 lg:col-span-4 lg:col-start-9 lg:pb-2">
      <ul class="grid grid-cols-2 gap-x-6 sm:flex sm:flex-wrap lg:grid lg:grid-cols-2">
        {links.map((link) => (
          <li>
            <a
              class="link-arrow hover:text-paper inline-flex min-h-11 items-center bg-none pb-0 no-underline lg:min-h-9"
              href={link.href}
            >
              {link.label}
              {link.isExternal && (
                <>
                  <span class="sr-only"> {t(locale, 'nav.external')}</span>
                  <Arrow
                    direction="out"
                    class="btn-arrow"
                  />
                </>
              )}
            </a>
          </li>
        ))}
      </ul>
      <ul class="border-line-dark flex flex-wrap gap-x-6 border-t pt-2">
        {contactLinks.map((link) => (
          <li>
            <a
              class:list={[
                'hover:text-paper inline-flex min-h-11 items-center no-underline lg:min-h-9',
                link.isEmail && 'tracking-normal normal-case',
              ]}
              href={link.href}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="border-line-dark border-t">
    <div class="container-site label flex flex-wrap items-center justify-between gap-x-8 py-1">
      <ul class="flex flex-wrap gap-x-6">
        {legalLinks.map((link) => (
          <li>
            <a
              class="hover:text-paper inline-flex min-h-11 items-center no-underline lg:min-h-9"
              href={link.href}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <p class="py-3 lg:py-2">
        © {year} Zement · {t(locale, 'brand.tagline')}
      </p>
    </div>
  </div>
</footer>
