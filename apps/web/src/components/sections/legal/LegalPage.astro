---
import type { CollectionEntry } from 'astro:content';
import { company } from '../../../data/company';
import { renderLegal } from '../../../lib/legal';
import { localePath, t, type Locale } from '../../../i18n/ui';

interface Props {
  locale: Locale;
  entry: CollectionEntry<'legal'>;
}

const { locale, entry } = Astro.props;
const html = renderLegal(entry.body ?? '');
---

<article class="pt-28 pb-section md:pt-36">
  <div class="container-site">
    <nav
      aria-label={t(locale, 'legal.crumbs')}
      class="label text-muted"
    >
      <ol class="-my-1.5 flex flex-wrap items-baseline gap-x-2">
        <li>
          <a
            class="inline-block py-1.5 hover:text-navy"
            href={localePath(locale, '/')}
          >
            {t(locale, 'legal.home')}
          </a>
          <span aria-hidden="true"> /</span>
        </li>
        <li aria-current="page">{entry.data.title}</li>
      </ol>
    </nav>

    <header class="border-navy mt-8 grid gap-6 border-b pb-10 md:grid-cols-12 md:items-end">
      <h1 class="display-xl text-navy md:col-span-8">{entry.data.title}</h1>
      <p class="label text-muted md:col-span-4 md:text-right">
        {t(locale, 'legal.updated')}: {company.legal.updated}
      </p>
    </header>

    {entry.data.draft && (
      <p
        class="border-gold text-ink mt-8 max-w-3xl border border-dashed p-4 text-sm"
        role="note"
      >
        {t(locale, 'legal.draft')}
      </p>
    )}

    <div
      class="prose-legal mt-10 max-w-3xl"
      set:html={html}
    />
  </div>
</article>
