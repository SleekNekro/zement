---
import Button from '../../ui/Button.astro';
import RevealHeading from '../../ui/RevealHeading.astro';
import type { HomeContent } from '../../../data/home';
import { shopUrl } from '../../../lib/shop';
import { t, type Locale } from '../../../i18n/ui';

interface Props {
  locale: Locale;
  /** Nivel del titular: 3 cuando la sección va dentro de un capítulo. */
  level?: 2 | 3;
  application: HomeContent['application'];
}

const { locale, application, level = 2 } = Astro.props;
const headingTag = `h${level}` as 'h2' | 'h3';
---

<section
  id="aplicacion"
  class="bg-navy text-paper py-section"
>
  <div class="container-site grid gap-16 lg:grid-cols-12">
    <div class="lg:col-span-6">
      <RevealHeading
        as={headingTag}
        lines={application.title}
        emphasis={1}
        class="display-lg"
      />
      <p
        class="text-paper/70 mt-8 max-w-md"
        data-reveal
      >
        {application.text}
      </p>
      <div
        class="mt-10"
        data-reveal
      >
        <div class="flex flex-wrap gap-3">
          <Button
            href={shopUrl(locale)}
            variant="solid-light"
            arrow="out"
          >
            {application.shopCta}
            <span class="sr-only"> {t(locale, 'nav.external')}</span>
          </Button>
          <Button
            href="#contacto"
            variant="outline-light"
            arrow="down"
            data-interest="application"
          >
            {application.cta}
          </Button>
        </div>
      </div>
    </div>

    <!-- Dónde se aplica: una lista de texto corrido, sin numerar ni simular interacción -->
    <ul class="display text-paper/90 grid content-end gap-x-8 gap-y-4 text-2xl sm:grid-cols-2 md:text-3xl lg:col-span-5 lg:col-start-8 lg:grid-cols-1">
      {application.areas.map((area, index) => (
        <li
          class="flex items-baseline gap-3"
          data-reveal
          style={`--reveal-index: ${index}`}
        >
          <span
            class="bg-gold inline-block size-1.5 shrink-0 -translate-y-1.5"
            aria-hidden="true"
          />
          {area}
        </li>
      ))}
    </ul>
  </div>
</section>
