---
import { Image } from 'astro:assets';
import bathroom from '../../../assets/fotos/bano-paredes-microcemento.jpg';
import texture from '../../../assets/fotos/pared-microcemento-luz.jpg';
import detail from '../../../assets/fotos/hornacina-microcemento.jpg';

// Fondo de la portada: collage recto de espacio, materia y detalle, separado por filetes de 1 px.
// Fotos decorativas (el contenido está en el titular): baño, textura y detalle de microcemento.
const tile = 'hero-media size-full object-cover';
---

<div
  class="bg-night absolute inset-0 -z-10 grid grid-cols-2 grid-rows-[2fr_1fr] gap-px lg:grid-cols-12 lg:grid-rows-2"
  aria-hidden="true"
>
  <div class="col-span-2 overflow-hidden lg:col-span-7 lg:row-span-2">
    <Image
      src={bathroom}
      alt=""
      widths={[640, 1024, 1600, 2000]}
      sizes="(min-width: 1024px) 58vw, 100vw"
      loading="eager"
      fetchpriority="high"
      class={tile}
    />
  </div>
  <div class="overflow-hidden lg:col-span-5">
    <Image
      src={texture}
      alt=""
      widths={[480, 800, 1200]}
      sizes="(min-width: 1024px) 42vw, 50vw"
      class={tile}
    />
  </div>
  <div class="overflow-hidden lg:col-span-5">
    <Image
      src={detail}
      alt=""
      widths={[480, 800, 1200]}
      sizes="(min-width: 1024px) 42vw, 50vw"
      class={tile}
    />
  </div>
</div>

<!-- Velo: mantiene legibles la cabecera (arriba) y el titular (abajo) sobre las fotos -->
<div
  class="from-night/70 to-night/0 absolute inset-x-0 top-0 -z-10 h-40 bg-linear-to-b"
  aria-hidden="true"
/>
<div
  class="from-night via-night/80 to-night/10 lg:via-night/55 lg:to-night/0 absolute inset-0 -z-10 bg-linear-to-t"
  aria-hidden="true"
/>
