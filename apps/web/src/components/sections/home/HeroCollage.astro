---
import { Image } from 'astro:assets';
import texture from '../../../assets/fotos/textura-microcemento-generada.jpg';

// Fondo de la portada: plano, textura de microcemento generada por código (2880 px) imitando la
// pared de la foto del arco, en un tono más claro. Decorativo.
---

<div
  class="bg-night absolute inset-0 -z-10 overflow-hidden"
  aria-hidden="true"
>
  <Image
    src={texture}
    alt=""
    widths={[640, 1024, 1440, 1920, 2880]}
    quality={90}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="hero-media size-full object-cover"
  />
</div>

<!-- Velo: oscurece arriba (cabecera) y abajo (titular y caminos) para que el texto se lea -->
<div
  class="from-night/40 to-night/0 absolute inset-x-0 top-0 -z-10 h-36 bg-linear-to-b"
  aria-hidden="true"
/>
<div
  class="from-night/70 via-night/25 to-night/0 lg:via-night/15 absolute inset-0 -z-10 bg-linear-to-t"
  aria-hidden="true"
/>
<!-- Sombra lateral suave: da contraste al titular y al texto, que van a la izquierda -->
<div
  class="from-night/45 via-night/15 to-night/0 absolute inset-0 -z-10 bg-linear-to-r"
  aria-hidden="true"
/>
