---
import { Image } from 'astro:assets';
import background from '../../../assets/fotos/acabados/fondo-aluminio-relieve.jpg';

/*
 * Fondo de la portada: foto real de una pared metálica con relieve (mandalas y geometría
 * estampados), pasada a tono aluminio para que encaje con la paleta fría de la web. Degradado
 * arriba (cabecera) y abajo (titular y caminos) para que el texto se lea. Decorativo.
 */
---

<div
  class="bg-night absolute inset-0 -z-10 overflow-hidden"
  aria-hidden="true"
>
  <Image
    src={background}
    alt=""
    widths={[640, 1024, 1440, 1920, 2400]}
    quality={82}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="hero-media size-full object-cover"
  />
</div>

<!-- Degradado arriba (cabecera) y abajo (titular y caminos) para que el texto se lea -->
<div
  class="from-night/80 via-night/20 to-night/0 absolute inset-x-0 top-0 -z-10 h-[40%] bg-linear-to-b"
  aria-hidden="true"
/>
<div
  class="from-night via-night/60 to-night/0 absolute inset-x-0 bottom-0 -z-10 h-[75%] bg-linear-to-t"
  aria-hidden="true"
/>
<!-- Sombra lateral suave: el relieve brilla mucho a la izquierda, donde van el titular y el texto -->
<div
  class="from-night/60 via-night/20 to-night/0 absolute inset-0 -z-10 bg-linear-to-r"
  aria-hidden="true"
/>
