---
import RevealHeading from '../../ui/RevealHeading.astro';
import Arrow from '../../ui/Arrow.astro';
import Todo from '../../ui/Todo.astro';
import type { HomeContent } from '../../../data/home';

interface Props {
  /** Nivel del titular: 3 cuando la sección va dentro de un capítulo. */
  level?: 2 | 3;
  contact: HomeContent['contact'];
}

const { contact, level = 2 } = Astro.props;
const headingTag = `h${level}` as 'h2' | 'h3';
---

<section
  id="contacto"
  class="bg-navy text-paper py-section"
>
  <div class="container-site grid gap-16 md:grid-cols-12">
    <div class="md:col-span-5">
      <RevealHeading
        as={headingTag}
        lines={contact.title}
        emphasis={1}
        class="display-lg"
      />
      <p
        class="text-paper/70 mt-8 max-w-sm"
        data-reveal
      >
        {contact.text}
      </p>
      <p class="label text-sand mt-12">{contact.signature}</p>
    </div>

    <form
      class="grid gap-8 md:col-span-6 md:col-start-7"
      data-reveal
    >
      <label class="label text-sand grid gap-1">
        <span>
          {contact.fields.name} <span aria-hidden="true">*</span>
        </span>
        <input
          class="field tracking-normal normal-case"
          name="name"
          required
          autocomplete="name"
          placeholder={contact.placeholders.name}
        />
      </label>
      <label class="label text-sand grid gap-1">
        <span>
          {contact.fields.email} <span aria-hidden="true">*</span>
        </span>
        <input
          class="field tracking-normal normal-case"
          type="email"
          required
          name="email"
          autocomplete="email"
          placeholder={contact.placeholders.email}
        />
      </label>
      <label class="label text-sand grid gap-1">
        {contact.fields.interest}
        <select
          class="field [&>option]:text-navy tracking-normal normal-case"
          name="interest"
        >
          {contact.interests.map((option) => (
            <option>{option}</option>
          ))}
        </select>
      </label>
      <label class="label text-sand grid gap-1">
        {contact.fields.message}
        <textarea
          class="field min-h-28 resize-y tracking-normal normal-case"
          name="message"
          placeholder={contact.placeholders.message}
        ></textarea>
      </label>
      <p class="text-paper/60 text-sm">{contact.requiredNote}</p>
      <div class="grid gap-5">
        <button
          class="btn btn-solid-light w-fit cursor-not-allowed opacity-60"
          type="submit"
          disabled
          aria-describedby="contact-status"
        >
          <span>{contact.submit}</span>
          <Arrow
            direction="next"
            class="btn-arrow"
          />
        </button>
        <p
          id="contact-status"
          class="text-paper/75 max-w-md text-sm"
        >
          {contact.unavailable} <Todo text={contact.emailTodo} />. {contact.nextStep}{' '}
          <Todo text={contact.responseTodo} />.
        </p>
      </div>
    </form>
  </div>
</section>
