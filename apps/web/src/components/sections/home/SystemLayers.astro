---
import RevealHeading from '../../ui/RevealHeading.astro';
import Arrow from '../../ui/Arrow.astro';
import LayerStack from '../../ui/LayerStack.astro';
import Button from '../../ui/Button.astro';
import Value from '../../ui/Value.astro';
import type { LocalizedSystem } from '../../../lib/systems';
import type { HomeContent } from '../../../data/home';

interface Props {
  /** Nivel del titular: 3 cuando la sección va dentro de un capítulo. */
  level?: 2 | 3;
  system: HomeContent['system'];
  /** URL de la página completa del sistema. */
  systemHref: string;
  /** Datos técnicos del sistema (misma fuente que su página): una fila por dato, un valor por capa. */
  specs: LocalizedSystem['specs'];
}

const { system, systemHref, specs, level = 2 } = Astro.props;
const headingTag = `h${level}` as 'h2' | 'h3';
const SubHeading = `h${level + 1}` as 'h3' | 'h4';
---

<section
  id="sistema"
  class="py-section"
>
  <div class="container-site">
    <div class="grid gap-10 md:grid-cols-12">
      <div class="md:col-span-7">
        <RevealHeading
          as={headingTag}
          lines={system.title}
          emphasis={1}
          class="display-lg text-navy"
        />
      </div>
      <p
        class="text-muted self-end md:col-span-4 md:col-start-9"
        data-reveal
      >
        {system.text}
      </p>
    </div>

    <!--
      Corte transversal fijo (en escritorio a la izquierda, en móvil arriba) mientras pasan los pasos:
      cada capa se extiende de abajo arriba al llegar a su paso. En móvil se usa bloque (no grid)
      para que `sticky` funcione respecto a toda la sección.
    -->
    <div class="mt-16 md:mt-24 lg:grid lg:grid-cols-12 lg:gap-12">
      <figure class="bg-paper sticky top-[var(--header-offset)] z-(--zm-z-raised) -mx-[var(--zm-gutter)] px-[var(--zm-gutter)] pt-4 pb-5 lg:top-[calc(var(--header-offset)+1.5rem)] lg:col-span-6 lg:mx-0 lg:self-start lg:px-0 lg:pt-0 lg:pb-0">
        <figcaption class="label text-muted mb-3 flex items-center justify-between gap-4 lg:mb-5">
          <span>{system.layersLabel}</span>
          <span class="hidden items-center gap-2 sm:flex">
            <Arrow
              direction="next"
              class="-rotate-90"
            />
            {system.layersDirection}
          </span>
        </figcaption>

        <LayerStack
          layers={system.steps}
          label={system.layersLabel}
          supportLabel={system.supportLabel}
          thicknessLabel={system.thicknessTodo}
          class="h-[26svh] min-h-44 lg:h-[min(68svh,40rem)]"
        />
      </figure>

      <ol class="mt-6 lg:col-span-5 lg:col-start-8 lg:mt-0">
        {system.steps.map((step, index) => (
          <li
            class="group border-line flex gap-6 border-t py-10 md:gap-10 lg:min-h-[44svh] lg:py-14"
            data-layer-step={index}
            data-active="false"
          >
            <span
              aria-hidden="true"
              class="display text-line group-data-[active=true]:text-navy text-5xl transition-colors duration-(--zm-duration) md:text-7xl"
            >
              {String(index + 1).padStart(2, '0')}
            </span>
            <div class="pt-2">
              <p class="label text-muted">
                {system.stepLabel} {index + 1} · {step.code}
              </p>
              <SubHeading class="display-lg text-navy mt-3">{step.name}</SubHeading>
              <p class="text-muted mt-4 max-w-sm">{step.text}</p>
              <dl class="border-line mt-6 grid max-w-sm grid-cols-2 gap-x-6 border-t pt-4">
                {specs.map((row) => (
                  <div>
                    <dt class="label text-muted">{row.label}</dt>
                    <dd class="text-navy mt-1 tabular-nums">
                      <Value text={row.values[index] ?? 'TODO'} />
                    </dd>
                  </div>
                ))}
              </dl>
            </div>
          </li>
        ))}
      </ol>
    </div>

    <div
      class="border-navy mt-16 grid gap-8 border-t pt-10 md:grid-cols-12 md:items-center"
      data-reveal
    >
      <p class="text-muted md:col-span-6">{system.fullSystemText}</p>
      <div class="md:col-span-5 md:col-start-8 md:text-right">
        <Button
          href={systemHref}
          variant="solid-dark"
          arrow="next"
        >
          {system.fullSystemCta}
        </Button>
      </div>
    </div>
  </div>
</section>
