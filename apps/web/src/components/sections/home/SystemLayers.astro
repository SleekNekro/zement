---
import { Image } from 'astro:assets';
import RevealHeading from '../../ui/RevealHeading.astro';
import Button from '../../ui/Button.astro';
import Todo from '../../ui/Todo.astro';
import Value from '../../ui/Value.astro';
import { cubeBackdrops } from '../../../data/systemCube';
import type { LocalizedSystem } from '../../../lib/systems';
import type { HomeContent } from '../../../data/home';

interface Props {
  /** Nivel del titular: 3 cuando la sección va dentro de un capítulo. */
  level?: 2 | 3;
  system: HomeContent['system'];
  /** URL de la página completa del sistema. */
  systemHref: string;
  /** Datos técnicos del sistema (misma fuente que su página): una fila por dato, un valor por capa. */
  specs: LocalizedSystem['specs'];
}

const { system, systemHref, specs, level = 2 } = Astro.props;
const headingTag = `h${level}` as 'h2' | 'h3';

/*
 * Fases del montaje: el soporte existente (siempre presente) y una losa por capa. Grosores en
 * unidades `--u` (1/16 del ancho del cubo), exagerados para que cada capa se vea; los reales están
 * pendientes (thicknessTodo). Cada fase lleva su material simulado (`mat-*`, en global.css).
 */
const support = {
  code: '',
  name: system.supportLabel,
  text: system.supportText,
  material: 'mat-support',
  height: 7,
  values: [] as string[],
  note: system.supportNote,
};
const layerMaterials = [
  'mat-repair',
  'mat-preparation',
  'mat-base',
  'mat-finish',
  'mat-protection',
];
const thickness = [0.7, 0.6, 1.7, 1.1, 0.5];
const layers = [system.repair, ...system.steps].map((layer, index) => ({
  ...layer,
  material: layerMaterials[index] ?? 'mat-finish',
  height: thickness[index] ?? 1,
  // La reparación usa los datos de su mortero; las capas, los del sistema.
  values: specs.map((row, rowIndex) =>
    index === 0
      ? (system.repair.specValues[rowIndex] ?? 'TODO')
      : (row.values[index - 1] ?? 'TODO'),
  ),
  note: '',
}));
/*
 * Numeración única para pistas y fichas: soporte y reparación son «Antes del sistema»; las cuatro
 * capas del sistema son «Capa 1–4», igual que Z.01–Z.04 en el resto de la portada.
 */
const stageLabel = (index: number, before: string): string =>
  index < 2 ? before : `${system.stepLabel} ${index - 1}`;
let bottom = 0;
// La reparación se funde con el soporte (rellena sus grietas): no suma altura a la pila.
const phases = [support, ...layers].map((phase, index) => {
  const slab = {
    ...phase,
    index,
    bottom,
    stage: stageLabel(index, system.beforeLabel),
    stageShort: stageLabel(index, system.beforeShort),
  };
  if (index !== 1) bottom += phase.height;
  return slab;
});
// Con la vista fija del cubo solo se ven estas dos caras laterales (más la superior).
const sides = ['front', 'right'] as const;
---

<section
  id="sistema"
  class="py-section"
>
  <div class="container-site">
    <div class="grid gap-10 md:grid-cols-12">
      <div class="md:col-span-7">
        <RevealHeading
          as={headingTag}
          lines={system.title}
          emphasis={1}
          class="display-lg text-navy"
        />
      </div>
      <p
        class="text-muted self-end md:col-span-4 md:col-start-9"
        data-reveal
      >
        {system.text}
      </p>
    </div>

    <!--
      Cubo del sistema: un bloque de soporte y una losa por fase que cae y se asienta en su orden,
      como un vídeo que se puede pausar o recorrer por fases (layerCube.ts). Cada losa lleva en su
      cara superior la foto de esa fase (o su textura). Sin JavaScript: cubo montado y todas las
      fichas seguidas; con «reducir movimiento», cubo montado y sin reproducción automática.
    -->
    <figure
      class="mt-14 md:mt-20"
      data-cube
    >
      <figcaption class="label text-muted mb-4 flex flex-wrap justify-between gap-x-6 gap-y-1">
        <span>{system.layersLabel}</span>
        <span class="text-navy hidden [[data-cube][data-ready]_&]:inline">{system.layersHint}</span>
      </figcaption>

      <div
        class="cube-scene border-navy/30 bg-stone relative isolate border"
        role="img"
        aria-label={`${system.layersLabel}: ${phases.map((phase) => phase.name).join(', ')}`}
      >
        <!-- Fondo: foto real de la fase en pantalla; se funden al cambiar de fase -->
        {cubeBackdrops.map((photo, index) =>
          photo ? (
            <Image
              src={photo}
              alt=""
              widths={[640, 1024, 1600]}
              sizes="(min-width: 1280px) 80rem, 100vw"
              class="cube-backdrop absolute inset-0 -z-10 size-full object-cover"
              data-cube-backdrop={index}
              data-visible={String(index === cubeBackdrops.length - 1)}
            />
          ) : null,
        )}
        <div
          class="bg-paper/55 absolute inset-0 -z-10"
          aria-hidden="true"
        />
        <div class="cube is-complete">
          {phases.map((phase) => (
            <div
              class:list={[
                'slab is-built',
                phase.index === 0 && 'slab-support is-repaired',
                phase.index === 1 && 'slab-repair',
                phase.index === phases.length - 1 && 'slab-protection',
              ]}
              style={`--h: calc(var(--u) * ${phase.height}); --y: calc(var(--u) * ${phase.bottom})`}
              data-slab={phase.index}
            >
              <div class:list={['face face-top', phase.material]}>
                {phase.index === 0 && <span class="cracks mat-cracks" />}
                {phase.index === 2 && <span class="mesh mat-mesh" />}
              </div>
              {sides.map((side) => (
                <div class:list={['face face-side', `face-${side}`, phase.material]}>
                  {phase.index === 0 && <span class="cracks mat-cracks" />}
                  {/* Al terminar, los cantos de las capas se unen en un solo bloque acabado */}
                  {phase.index > 1 && <span class="skin mat-finish" />}
                </div>
              ))}
            </div>
          ))}
        </div>
      </div>

      <!-- Controles tipo vídeo: reproducir/pausar y una pista por fase con su progreso -->
      <div
        class="border-navy mt-4 hidden border [[data-cube][data-ready]_&]:flex"
        data-cube-controls
      >
        <button
          type="button"
          class="border-navy text-navy hover:bg-navy hover:text-paper grid w-14 shrink-0 place-items-center border-r transition-colors duration-(--zm-duration)"
          aria-label={system.player.play}
          data-cube-play
          data-label-play={system.player.play}
          data-label-pause={system.player.pause}
          data-label-replay={system.player.replay}
        >
          <svg
            class="cube-icon-play size-4"
            viewBox="0 0 16 16"
            aria-hidden="true"
          >
            <path
              d="M4 2.5v11l9-5.5z"
              fill="currentColor"
            />
          </svg>
          <svg
            class="cube-icon-pause size-4"
            viewBox="0 0 16 16"
            aria-hidden="true"
          >
            <path
              d="M4 2.5h3v11H4zM9 2.5h3v11H9z"
              fill="currentColor"
            />
          </svg>
        </button>
        <ol
          class="grid flex-1 grid-cols-3 sm:grid-cols-6"
          aria-label={system.player.phases}
        >
          {phases.map((phase) => (
            <li class="border-navy/30 border-t border-l sm:border-t-0 [&:nth-child(-n+3)]:border-t-0 [&:nth-child(3n+1)]:border-l-0 sm:[&:nth-child(3n+1)]:border-l sm:first:border-l-0">
              <button
                type="button"
                class="cube-step text-navy hover:bg-white relative flex h-full min-h-14 w-full flex-col justify-center px-2 py-2.5 text-left transition-colors duration-(--zm-duration) sm:px-4"
                aria-controls={`cube-info-${phase.index}`}
                aria-pressed="false"
                data-cube-step={phase.index}
                data-state="todo"
              >
                <span class="label text-muted hidden sm:block">{phase.stageShort}</span>
                <span class="text-sm">{phase.name}</span>
                <span
                  class="cube-progress bg-gold absolute inset-x-0 bottom-0 h-0.5 origin-left"
                  aria-hidden="true"
                />
              </button>
            </li>
          ))}
        </ol>
      </div>

      <!-- Ficha de la fase en pantalla, debajo del cubo. Todas en la misma celda: sin saltos. -->
      <div
        class="info-stack mt-6"
        aria-live="off"
        data-cube-live
      >
        <p
          class="display-md text-navy/70 self-center leading-snug"
          data-cube-intro
        >
          {phases.map((phase) => phase.name).join(' · ')}
        </p>
        {phases.map((phase) => (
          <div
            class="grid gap-3 md:grid-cols-12 md:gap-8"
            id={`cube-info-${phase.index}`}
            data-cube-panel={phase.index}
          >
            <div class="md:col-span-4">
              <p class="label text-muted">
                {phase.stage}
                {phase.code && (
                  <>
                    {' · '}
                    <Value text={phase.code} />
                  </>
                )}
              </p>
              <p class="display-md text-navy mt-2">{phase.name}</p>
            </div>
            <p class="text-muted md:col-span-4 md:self-end">{phase.text}</p>
            {phase.note && <p class="text-navy md:col-span-4 md:self-end">{phase.note}</p>}
            <dl
              class:list={[
                'grid grid-cols-2 gap-x-6 gap-y-2 md:col-span-4 md:self-end',
                phase.values.length === 0 && 'hidden',
              ]}
            >
              {specs.map((row, rowIndex) => (
                <div>
                  <dt class="label text-muted">{row.label}</dt>
                  <dd class="text-navy mt-1 text-sm tabular-nums">
                    <Value text={phase.values[rowIndex] ?? 'TODO'} />
                  </dd>
                </div>
              ))}
            </dl>
          </div>
        ))}
      </div>

      <p class="mt-6 flex flex-wrap gap-x-6 gap-y-2">
        <Todo text={system.photoTodo} />
        <span class="text-muted text-sm">{system.thicknessNote}</span>
      </p>
    </figure>

    <div
      class="border-navy mt-14 grid gap-8 border-t pt-10 md:grid-cols-12 md:items-center"
      data-reveal
    >
      <p class="text-muted md:col-span-6">{system.fullSystemText}</p>
      <div class="md:col-span-5 md:col-start-8 md:text-right">
        <Button
          href={systemHref}
          variant="solid-dark"
          arrow="next"
        >
          {system.fullSystemCta}
        </Button>
      </div>
    </div>
  </div>
</section>

<script src="../../../scripts/layerCube.ts"></script>
