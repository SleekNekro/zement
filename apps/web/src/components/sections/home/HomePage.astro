---
import Hero from './Hero.astro';
import Manifesto from './Manifesto.astro';
import SystemLayers from './SystemLayers.astro';
import Application from './Application.astro';
import ShopCategories from './ShopCategories.astro';
import Method from './Method.astro';
import Contact from './Contact.astro';
import { home } from '../../../data/home';
import type { Locale } from '../../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = home[locale];
---

<Hero
  locale={locale}
  hero={content.hero}
  marquee={content.marquee}
/>
<Manifesto intro={content.intro} />
<SystemLayers system={content.system} />
<Application application={content.application} />
<ShopCategories
  locale={locale}
  shop={content.shop}
/>
<Method method={content.method} />
<Contact contact={content.contact} />
