---
import RevealHeading from '../../ui/RevealHeading.astro';
import Value from '../../ui/Value.astro';
import type { HomeContent } from '../../../data/home';

interface Props {
  /** Nivel del titular: 3 cuando la sección va dentro de un capítulo. */
  level?: 2 | 3;
  method: HomeContent['method'];
}

const { method, level = 2 } = Astro.props;
const headingTag = `h${level}` as 'h2' | 'h3';
---

<!-- Método como recorrido: titular a todo el ancho y los compromisos en una fila, de izquierda a derecha -->
<section class="bg-stone text-navy py-section">
  <div class="container-site">
    <RevealHeading
      as={headingTag}
      lines={[method.title.join(' ')]}
      class="display-xl max-w-6xl"
    />
    <p
      class="text-navy/80 mt-8 max-w-2xl"
      data-reveal
    >
      <Value text={method.text} />
    </p>
    <ol class="mt-16 grid gap-x-8 sm:grid-cols-2 lg:grid-cols-4">
      {method.points.map((point, index) => (
        <li
          class="border-navy label grid content-start gap-6 border-t pt-5 pb-8"
          data-reveal
          style={`--reveal-index: ${index}`}
        >
          <span
            class="bg-gold size-1.5"
            aria-hidden="true"
          />
          <Value text={point} />
        </li>
      ))}
    </ol>
  </div>
</section>
