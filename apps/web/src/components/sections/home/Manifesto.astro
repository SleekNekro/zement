---
import Arrow from '../../ui/Arrow.astro';
import RevealHeading from '../../ui/RevealHeading.astro';
import Value from '../../ui/Value.astro';
import { isTodo } from '../../../lib/systems';
import type { HomeContent } from '../../../data/home';

interface Props {
  intro: HomeContent['intro'];
}

const { intro } = Astro.props;
const [lead, ...rest] = intro.paragraphs;
---

<section
  id="manifiesto"
  class="py-section"
>
  <div class="container-site grid gap-12 md:grid-cols-12">
    <div class="md:col-span-5">
      <RevealHeading
        lines={intro.title}
        class="display-lg text-navy"
      />
    </div>
    <div class="grid content-start gap-10 md:col-span-6 md:col-start-7">
      {isTodo(lead ?? '') ? (
        <p>
          <Value text={lead ?? ''} />
        </p>
      ) : (
        <p
          class="display-md text-navy font-light"
          data-scrub-words
        >
          {lead}
        </p>
      )}
      {rest.map((paragraph) => (
        <p
          class="text-muted max-w-[65ch]"
          data-reveal
        >
          <Value text={paragraph} />
        </p>
      ))}
      <a
        class="link-arrow label text-navy min-h-11 w-fit items-end"
        href="#sistema"
        data-reveal
      >
        {intro.link}
        <Arrow
          direction="down"
          class="btn-arrow"
        />
      </a>
    </div>
  </div>
</section>
