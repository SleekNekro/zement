---
import Button from '../../ui/Button.astro';
import RevealHeading from '../../ui/RevealHeading.astro';
import Todo from '../../ui/Todo.astro';
import type { HomeContent } from '../../../data/home';
import { shopUrl } from '../../../lib/shop';
import type { Locale } from '../../../i18n/ui';

interface Props {
  locale: Locale;
  hero: HomeContent['hero'];
  marquee: string[];
}

const { locale, hero, marquee } = Astro.props;
---

<section
  class="surface-material text-paper relative isolate flex min-h-svh flex-col overflow-hidden"
  data-hero
>
  <div
    class="hero-light"
    aria-hidden="true"
  ></div>

  <!-- Retícula de 12 columnas visible: orden y precisión -->
  <div
    aria-hidden="true"
    class="container-site pointer-events-none absolute inset-0 -z-10 grid grid-cols-4 md:grid-cols-12"
  >
    {Array.from({ length: 12 }, (_, i) => (
      <span class:list={['border-line-dark/40 border-l', i >= 4 && 'hidden md:block']} />
    ))}
  </div>

  <div class="container-site flex flex-1 flex-col justify-end pt-32 pb-10 md:pb-14">
    <p
      class="label text-sand"
      data-reveal
    >
      {hero.eyebrow}
    </p>
    <RevealHeading
      as="h1"
      lines={hero.title}
      emphasis={1}
      class="display-hero mt-6 md:mt-10"
    />

    <div class="mt-10 grid gap-8 md:mt-16 md:grid-cols-12 md:items-end">
      <div
        class="bg-line-dark h-px md:col-span-12"
        data-reveal-rule
      ></div>
      <p
        class="text-paper/75 max-w-md md:col-span-5"
        data-reveal
      >
        {hero.text}
      </p>
      <div
        class="flex flex-col gap-3 sm:flex-row md:col-span-7 md:justify-end"
        data-reveal
        style="--reveal-index: 1"
      >
        <Button
          href="#aplicacion"
          variant="solid-light"
          arrow={false}
        >
          {hero.primary}
        </Button>
        <Button
          href={shopUrl(locale)}
          variant="outline-light"
        >
          {hero.secondary}
        </Button>
      </div>
    </div>

    <div class="mt-10 flex items-end justify-between gap-6">
      <Todo text={hero.imageTodo} />
      <a
        href="#manifiesto"
        class="label text-sand hidden flex-col items-center gap-3 no-underline md:flex"
      >
        {hero.scroll}
        <span
          class="scroll-cue"
          aria-hidden="true"
        ></span>
      </a>
    </div>
  </div>

  <div
    class="border-line-dark display text-paper/90 border-t py-5 text-xl md:text-2xl"
    aria-hidden="true"
  >
    <div class="marquee">
      {[0, 1].map(() => (
        <div class="marquee-track">
          {marquee.map((word) => (
            <>
              <span class="uppercase">{word}</span>
              <span class="text-gold">■</span>
            </>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>
