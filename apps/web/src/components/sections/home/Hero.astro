---
import AudiencePaths from './AudiencePaths.astro';
import RevealHeading from '../../ui/RevealHeading.astro';
import Todo from '../../ui/Todo.astro';
import type { HomeContent } from '../../../data/home';
import type { Locale } from '../../../i18n/ui';

interface Props {
  locale: Locale;
  hero: HomeContent['hero'];
  marquee: string[];
}

const { locale, hero, marquee } = Astro.props;
---

<section
  class="surface-material text-paper relative isolate flex min-h-svh flex-col overflow-hidden"
  data-hero
>
  <div
    class="hero-light"
    aria-hidden="true"
  ></div>

  <!-- Retícula de 12 columnas visible: orden y precisión -->
  <div
    aria-hidden="true"
    class="container-site pointer-events-none absolute inset-0 -z-10 grid grid-cols-4 md:grid-cols-12"
  >
    {Array.from({ length: 12 }, (_, i) => (
      <span class:list={['border-line-dark/40 border-l', i >= 4 && 'hidden md:block']} />
    ))}
  </div>

  <div class="container-site flex flex-1 flex-col justify-end pt-28 pb-6 md:pt-32">
    <RevealHeading
      as="h1"
      lines={hero.title}
      emphasis={1}
      class="display-hero"
    />

    <div class="mt-8 grid gap-8 md:mt-12 xl:grid-cols-12 xl:items-end xl:gap-10">
      <p
        class="text-paper/75 max-w-md xl:col-span-4 xl:pb-10"
        data-reveal
      >
        {hero.text}
      </p>
      <div class="xl:col-span-8">
        <AudiencePaths
          locale={locale}
          label={hero.pathsLabel}
          paths={hero.paths}
        />
      </div>
    </div>

    <p class="mt-2">
      <Todo text={hero.imageTodo} />
    </p>
  </div>

  <div
    class="border-line-dark display text-paper/90 border-t py-5 text-xl md:text-2xl"
    aria-hidden="true"
  >
    <div class="marquee">
      {[0, 1].map(() => (
        <div class="marquee-track">
          {marquee.map((word) => (
            <>
              <span class="uppercase">{word}</span>
              <span class="text-gold">■</span>
            </>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>
