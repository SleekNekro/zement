---
import AudiencePaths from './AudiencePaths.astro';
import HeroCollage from './HeroCollage.astro';
import Arrow from '../../ui/Arrow.astro';
import RevealHeading from '../../ui/RevealHeading.astro';
import Todo from '../../ui/Todo.astro';
import type { HomeContent } from '../../../data/home';
import { shopUrl } from '../../../lib/shop';
import { t, type Locale } from '../../../i18n/ui';

interface Props {
  locale: Locale;
  hero: HomeContent['hero'];
  shopStrip: HomeContent['shopStrip'];
  /** Capas del sistema (código y nombre) para la franja de la tienda. */
  layers: { code: string; name: string }[];
}

const { locale, hero, shopStrip, layers } = Astro.props;
---

<section
  class="surface-microcement-dark text-paper relative isolate flex min-h-svh flex-col overflow-hidden"
  data-hero
>
  <HeroCollage />

  <div class="container-site flex flex-1 flex-col justify-end pt-28 pb-10 md:pt-32 md:pb-14">
    <RevealHeading
      as="h1"
      lines={hero.title}
      emphasis={1}
      class="display-hero"
    />
    <p
      class="text-paper/75 order-2 mt-8 max-w-xl md:order-none md:mt-8"
      data-reveal
    >
      {hero.text}
    </p>

    <div class="order-1 mt-8 md:order-none md:mt-12">
      <AudiencePaths
        locale={locale}
        label={hero.pathsLabel}
        paths={hero.paths}
      />
    </div>

    <p class="order-3 mt-6 md:order-none">
      <Todo text={hero.imageTodo} />
    </p>
  </div>

  <!-- Franja fija (sin movimiento) que lleva a la tienda: la salida comercial siempre a la vista -->
  <a
    class="group border-line-dark hover:bg-paper hover:text-night relative block border-t no-underline transition-colors duration-(--zm-duration)"
    href={shopUrl(locale)}
  >
    <span class="container-site flex min-h-16 items-center justify-between gap-6 py-4">
      <span class="flex items-center gap-8">
        <span class="label text-sand group-hover:text-night transition-colors duration-(--zm-duration)">
          {shopStrip.label}
        </span>
        <span
          class="label text-paper/60 group-hover:text-night/70 hidden gap-6 transition-colors duration-(--zm-duration) lg:flex"
          aria-hidden="true"
        >
          {layers.map((layer) => (
            <span>
              {layer.code} {layer.name}
            </span>
          ))}
        </span>
      </span>
      <span class="label flex shrink-0 items-center gap-3">
        {shopStrip.cta}
        <span class="sr-only"> {t(locale, 'nav.external')}</span>
        <Arrow
          direction="out"
          class="btn-arrow size-4 transition-transform duration-(--zm-duration) group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
        />
      </span>
    </span>
  </a>
</section>
