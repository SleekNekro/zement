---
import Arrow from '../../ui/Arrow.astro';
import RevealHeading from '../../ui/RevealHeading.astro';
import type { Chapter } from '../../../data/home';

interface Props {
  chapter: Chapter;
  tone?: 'light' | 'dark';
}

const { chapter, tone = 'light' } = Astro.props;
---

<!-- Apertura de capítulo: nombra al público y ofrece el salto al otro capítulo. -->
<header
  class:list={[
    // Sin filetes. Tono claro: el mismo «stone» que el resto de secciones claras (tienda, método)
    tone === 'dark' ? 'bg-night text-paper' : 'bg-stone text-navy',
  ]}
>
  <div class="container-site grid gap-6 py-10 md:grid-cols-12 md:items-end md:py-14">
    <!-- Palabras muy largas (pl: «profesjonalistów») se parten con guion si no caben en la columna -->
    <RevealHeading
      as="h2"
      lines={[chapter.title]}
      class="display-xl hyphens-auto md:col-span-7"
    />
    <div class="grid min-w-0 gap-5 md:col-span-4 md:col-start-9">
      <p
        class:list={[tone === 'dark' ? 'text-paper/70' : 'text-ink/75']}
        data-reveal
      >
        {chapter.text}
      </p>
      {chapter.jumpLabel && chapter.jumpTo && (
        <a
          class:list={[
            'link-arrow label min-h-11 w-fit items-center bg-none pb-0',
            tone === 'dark' ? 'text-sand hover:text-paper' : 'text-ink/75 hover:text-navy',
          ]}
          href={`#${chapter.jumpTo}`}
          data-reveal
        >
          {chapter.jumpLabel}
          <Arrow
            direction="down"
            class="btn-arrow"
          />
        </a>
      )}
    </div>
  </div>
</header>
