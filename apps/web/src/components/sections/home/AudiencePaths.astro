---
import Arrow from '../../ui/Arrow.astro';
import Button from '../../ui/Button.astro';
import type { AudiencePath } from '../../../data/home';
import { resolveLink } from '../../../lib/links';
import { t, type Locale } from '../../../i18n/ui';

interface Props {
  locale: Locale;
  label: string;
  paths: AudiencePath[];
}

const { locale, label, paths } = Astro.props;
---

<!--
  Dos caminos como bloques compactos e iguales: se apilan en móvil y van uno al lado del otro
  desde tablet. Las acciones se reorganizan solas (flex-wrap) según el ancho disponible.
-->
<nav
  aria-label={label}
  class="grid gap-4 md:grid-cols-2"
>
  {paths.map((path, index) => {
    const primary = resolveLink(locale, path.primary.target);
    const secondary = resolveLink(locale, path.secondary.target);
    return (
      <div
        class="border-line-dark bg-night/40 flex flex-col justify-between gap-6 border p-6 md:p-8"
        data-reveal
        style={`--reveal-index: ${index + 1}`}
      >
        <div>
          <h2 class="display-md">{path.title}</h2>
          <p class="text-paper/70 mt-3 max-w-md text-sm md:text-base">{path.text}</p>
        </div>
        <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
          <Button
            href={primary.href}
            variant={index === 0 ? 'solid-light' : 'outline-light'}
            arrow={primary.isExternal ? 'out' : 'down'}
            class="w-full sm:w-auto"
            data-interest={primary.href === '#contacto' ? 'application' : undefined}
          >
            {path.primary.label}
            {primary.isExternal && <span class="sr-only"> {t(locale, 'nav.external')}</span>}
          </Button>
          <a
            class="link-arrow label text-sand hover:text-paper min-h-11 w-fit items-center bg-none pb-0 whitespace-nowrap"
            href={secondary.href}
          >
            {path.secondary.label}
            {secondary.isExternal && <span class="sr-only"> {t(locale, 'nav.external')}</span>}
            <Arrow
              direction={secondary.isExternal ? 'out' : 'down'}
              class="btn-arrow"
            />
          </a>
        </div>
      </div>
    );
  })}
</nav>
