---
import Button from '../../ui/Button.astro';
import RevealHeading from '../../ui/RevealHeading.astro';
import type { HomeContent } from '../../../data/home';
import { shopPathUrl, shopUrl } from '../../../lib/shop';
import { t, type Locale } from '../../../i18n/ui';
import Arrow from '../../ui/Arrow.astro';
import ShopTerms from '../../ui/ShopTerms.astro';
import Todo from '../../ui/Todo.astro';
import { company } from '../../../data/company';

interface Props {
  /** Nivel del titular: 3 cuando la sección va dentro de un capítulo. */
  level?: 2 | 3;
  locale: Locale;
  shop: HomeContent['shop'];
}

const { locale, shop, level = 2 } = Astro.props;
const headingTag = `h${level}` as 'h2' | 'h3';
const SubHeading = `h${level + 1}` as 'h3' | 'h4';
---

<section
  id="tienda"
  class="bg-stone pt-section"
>
  <div class="container-site">
    <div class="grid gap-10 md:grid-cols-12">
      <div class="md:col-span-7">
        <RevealHeading
          as={headingTag}
          lines={shop.title}
          emphasis={1}
          class="display-lg text-navy"
        />
      </div>
      <p
        class="text-ink/75 self-end md:col-span-4 md:col-start-9"
        data-reveal
      >
        {shop.text}
      </p>
    </div>

    <!--
      Familias de producto ligadas a las capas del sistema (Z.0x). La primera, el microcemento,
      va destacada; las demás, en filas. Cada una abre su búsqueda en la tienda.
    -->
    <ul class="border-navy mt-16 grid border-t md:mt-20 lg:grid-cols-12">
      {shop.categories.map((category, index) => {
        const isFeatured = index === 0;
        return (
          <li
            class:list={[
              'border-line border-b',
              isFeatured
                ? 'lg:col-span-6 lg:row-span-3 lg:border-r lg:border-b-0'
                : 'lg:col-span-6',
            ]}
            data-reveal
            style={`--reveal-index: ${index}`}
          >
            <a
              class:list={[
                'row-wipe group hover:text-paper flex h-full no-underline transition-colors duration-(--zm-duration) [--row-fill:var(--zm-color-night)]',
                isFeatured
                  ? 'min-h-72 flex-col justify-between gap-10 py-8 lg:min-h-[30rem] lg:p-10'
                  : 'items-center justify-between gap-6 py-6 lg:px-10 lg:py-8',
              ]}
              href={shopPathUrl(locale, category.shopPath)}
            >
              <span class="grid gap-3">
                {category.codes.length > 0 && (
                  <span class="label text-ink/75 group-hover:text-sand transition-colors duration-(--zm-duration)">
                    {category.codes.join(' · ')}
                  </span>
                )}
                <span
                  class:list={[
                    'display text-navy group-hover:text-paper block transition-colors duration-(--zm-duration)',
                    isFeatured ? 'text-4xl md:text-6xl' : 'text-2xl md:text-3xl',
                  ]}
                >
                  {category.name}
                </span>
                <span
                  class:list={[
                    'text-ink/75 group-hover:text-paper/70 max-w-sm transition-colors duration-(--zm-duration)',
                    !isFeatured && 'hidden sm:block',
                  ]}
                >
                  {category.text}
                </span>
              </span>
              <span class="label text-navy group-hover:text-paper flex shrink-0 items-center gap-3 transition-colors duration-(--zm-duration)">
                <span class:list={[!isFeatured && 'sr-only']}>{shop.cta}</span>
                <span class="sr-only"> {t(locale, 'nav.external')}</span>
                <Arrow
                  direction="out"
                  class="btn-arrow size-5 transition-transform duration-(--zm-duration) group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                />
              </span>
            </a>
          </li>
        );
      })}
    </ul>

    <ShopTerms
      locale={locale}
      class="border-line mt-8 mb-section border-t pt-6"
    />
  </div>

  <!-- Ventaja profesional: la tarifa aparece al iniciar sesión; primero el alta, después entrar. -->
  <div
    id="acceso-profesional"
    class="bg-navy text-paper"
    data-reveal
  >
    <div class="container-site grid gap-8 py-12 md:grid-cols-12 md:items-end md:py-16">
      <div class="md:col-span-7">
        <SubHeading class="display-md">{shop.proTitle}</SubHeading>
        <p class="text-paper/75 mt-4 max-w-lg">{shop.proText}</p>
      </div>
      <!-- Para quien aún no tiene cuenta (casi todos, al empezar): el alta va primero; entrar, después -->
      <div class="grid gap-4 md:col-span-5">
        <Button
          href={shopUrl(locale, 'register')}
          variant="solid-light"
          arrow="out"
          class="w-full sm:w-fit"
        >
          {shop.proCta}
          <span class="sr-only"> {t(locale, 'nav.external')}</span>
        </Button>
        <p class="text-paper/70 max-w-sm text-sm">
          {shop.proSignupSteps} <Todo text={company.proApprovalTime[locale]} />.
        </p>
        <p class="text-paper/70 flex flex-wrap items-center gap-x-3 text-sm">
          {shop.proSignupText}
          <a
            class="link-arrow label text-sand hover:text-paper inline-flex min-h-11 items-center bg-none pb-0"
            href={shopUrl(locale, 'login')}
          >
            {shop.proSignupCta}
            <span class="sr-only"> {t(locale, 'nav.external')}</span>
            <Arrow
              direction="out"
              class="btn-arrow"
            />
          </a>
        </p>
      </div>
    </div>
  </div>
</section>
