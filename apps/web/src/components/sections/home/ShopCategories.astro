---
import Button from '../../ui/Button.astro';
import RevealHeading from '../../ui/RevealHeading.astro';
import type { HomeContent } from '../../../data/home';
import { shopPathUrl, shopUrl } from '../../../lib/shop';
import { t, type Locale } from '../../../i18n/ui';
import Arrow from '../../ui/Arrow.astro';
import ShopTerms from '../../ui/ShopTerms.astro';
import Todo from '../../ui/Todo.astro';
import { company } from '../../../data/company';

interface Props {
  /** Nivel del titular: 3 cuando la sección va dentro de un capítulo. */
  level?: 2 | 3;
  locale: Locale;
  shop: HomeContent['shop'];
}

const { locale, shop, level = 2 } = Astro.props;
const headingTag = `h${level}` as 'h2' | 'h3';
const SubHeading = `h${level + 1}` as 'h3' | 'h4';
// Familia destacada: el microcemento es el producto principal de Zement.
const FEATURED_PATH = 'z/c/microcemento';
---

<section
  id="tienda"
  class="bg-stone pt-section"
>
  <div class="container-site">
    <div class="grid gap-10 md:grid-cols-12">
      <div class="md:col-span-7">
        <RevealHeading
          as={headingTag}
          lines={shop.title}
          emphasis={1}
          class="display-lg text-navy"
        />
      </div>
      <p
        class="text-ink/75 self-end md:col-span-4 md:col-start-9"
        data-reveal
      >
        {shop.text}
      </p>
    </div>

    <!--
      Familias de producto ligadas a las capas del sistema (Z.0x), en el orden de aplicación y todas
      del mismo tamaño. El microcemento, producto principal, va resaltado en azul con recuadro dorado.
      Cada tarjeta entera es un enlace a su categoría en la tienda, con «Ver en la tienda» visible.
    -->
    <ul class="mt-16 grid gap-4 sm:grid-cols-2 md:mt-20 lg:grid-cols-4">
      {shop.categories.map((category, index) => {
        const isFeatured = category.shopPath === FEATURED_PATH;
        return (
          <li
            class="flex"
            data-reveal
            style={`--reveal-index: ${index}`}
          >
            <a
              class:list={[
                'group relative flex min-h-80 w-full flex-col justify-between gap-10 border p-6 no-underline transition-[background-color,border-color,transform] duration-(--zm-duration) hover:-translate-y-1 lg:min-h-96 lg:p-8',
                isFeatured
                  ? 'bg-navy border-gold text-paper outline-gold hover:bg-night outline-1 outline-offset-4'
                  : 'border-line bg-paper text-navy hover:border-navy hover:bg-white',
              ]}
              href={shopPathUrl(locale, category.shopPath)}
            >
              <span class="grid gap-4">
                <span class:list={['label min-h-6', isFeatured ? 'text-sand' : 'text-ink/60']}>
                  {category.codes.length > 0 ? category.codes.join(' · ') : '—'}
                </span>
                <span
                  class:list={[
                    'display block text-3xl break-words sm:text-4xl lg:text-2xl xl:text-3xl',
                    isFeatured ? 'text-paper' : 'text-navy',
                  ]}
                >
                  {category.name}
                </span>
                <span class:list={[isFeatured ? 'text-paper/75' : 'text-ink/75']}>
                  {category.text}
                </span>
              </span>
              <span
                class:list={[
                  'label flex items-center justify-between gap-3 border-t pt-4',
                  isFeatured ? 'border-line-dark text-paper' : 'border-line text-navy',
                ]}
              >
                <span>{shop.cta}</span>
                <span class="sr-only"> {t(locale, 'nav.external')}</span>
                <Arrow
                  direction="out"
                  class="btn-arrow size-5 transition-transform duration-(--zm-duration) group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                />
              </span>
            </a>
          </li>
        );
      })}
    </ul>

    <ShopTerms
      locale={locale}
      class="border-line mt-10 mb-section border-t pt-6"
    />
  </div>

  <!-- Ventaja profesional: la tarifa aparece al iniciar sesión; primero el alta, después entrar. -->
  <div
    id="acceso-profesional"
    class="bg-navy text-paper"
    data-reveal
  >
    <div class="container-site grid gap-8 py-12 md:grid-cols-12 md:items-end md:py-16">
      <div class="md:col-span-7">
        <SubHeading class="display-md">{shop.proTitle}</SubHeading>
        <p class="text-paper/75 mt-4 max-w-lg">{shop.proText}</p>
      </div>
      <!-- Para quien aún no tiene cuenta (casi todos, al empezar): el alta va primero; entrar, después -->
      <div class="grid gap-4 md:col-span-5">
        <Button
          href={shopUrl(locale, 'register')}
          variant="solid-light"
          arrow="out"
          class="w-full sm:w-fit"
        >
          {shop.proCta}
          <span class="sr-only"> {t(locale, 'nav.external')}</span>
        </Button>
        <p class="text-paper/70 max-w-sm text-sm">
          {shop.proSignupSteps} <Todo text={company.proApprovalTime[locale]} />.
        </p>
        <p class="text-paper/70 flex flex-wrap items-center gap-x-3 text-sm">
          {shop.proSignupText}
          <a
            class="link-arrow label text-sand hover:text-paper inline-flex min-h-11 items-center bg-none pb-0"
            href={shopUrl(locale, 'login')}
          >
            {shop.proSignupCta}
            <span class="sr-only"> {t(locale, 'nav.external')}</span>
            <Arrow
              direction="out"
              class="btn-arrow"
            />
          </a>
        </p>
      </div>
    </div>
  </div>
</section>
