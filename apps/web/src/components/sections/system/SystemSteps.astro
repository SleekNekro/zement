---
import Value from '../../ui/Value.astro';
import type { SystemPageText } from '../../../data/systemPage';
import type { LocalizedSystem } from '../../../lib/systems';

interface Props {
  system: LocalizedSystem;
  text: SystemPageText;
}

const { system, text } = Astro.props;
---

<!--
  Aplicación paso a paso: aquí la numeración sí indica un orden real. Titular arriba y cada paso en
  una fila a todo el ancho (escritorio: número | capa y título | texto | tiempo), sin columna vacía
  bajo el titular. En móvil horizontal (landscape-short) se compacta: menos aire, pasos en dos
  columnas y el tiempo bajo el texto.
-->
<section
  id="aplicacion-sistema"
  class="bg-navy text-paper py-section landscape-short:py-12"
>
  <div class="container-site">
    <h2 class="display-lg">{text.stepsTitle}</h2>
    <ol class="border-line-dark mt-14 border-t landscape-short:mt-6 landscape-short:grid landscape-short:grid-cols-2 landscape-short:gap-x-8">
      {system.steps.map((step, index) => (
        <li
          class="border-line-dark grid gap-4 border-b py-8 sm:grid-cols-[4rem_1fr_auto] sm:gap-x-8 lg:grid-cols-12 lg:items-baseline landscape-short:grid-cols-[3rem_1fr] landscape-short:gap-x-6 landscape-short:gap-y-2 landscape-short:py-5"
          data-reveal
          style={`--reveal-index: ${index}`}
        >
          <span class="display text-sand text-3xl tabular-nums lg:col-span-1 landscape-short:row-span-3 landscape-short:text-2xl">
            {String(index + 1).padStart(2, '0')}
          </span>
          <div class="lg:col-span-4">
            <p class="label text-sand">
              {step.code
                ? `${step.code} · ${system.products.find((product) => product.code === step.code)?.layer ?? ''}`
                : text.supportLabel}
            </p>
            <h3 class="display-md mt-2 landscape-short:mt-1">{step.title}</h3>
          </div>
          <p class="text-paper/70 sm:col-span-2 sm:col-start-2 lg:col-span-4 lg:col-start-6 lg:row-start-1 landscape-short:col-span-1 landscape-short:col-start-2 landscape-short:row-start-auto">
            <Value text={step.text} />
          </p>
          <p class="label text-sand sm:col-start-3 sm:row-start-1 sm:text-right lg:col-span-3 lg:col-start-10 landscape-short:col-start-2 landscape-short:row-start-auto landscape-short:text-left">
            <span class="sr-only">{text.stepTime}: </span>
            <Value text={step.time} />
          </p>
        </li>
      ))}
    </ol>
  </div>
</section>
