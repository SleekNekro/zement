---
import Button from '../../ui/Button.astro';
import type { SystemPageText } from '../../../data/systemPage';
import type { LocalizedSystem } from '../../../lib/systems';
import { shopUrl } from '../../../lib/shop';
import { localePath, t, type Locale } from '../../../i18n/ui';

interface Props {
  locale: Locale;
  system: LocalizedSystem;
  text: SystemPageText;
}

const { locale, system, text } = Astro.props;
---

<!-- Cierre: dos salidas claras, hablar con un técnico o comprar. -->
<section class="surface-material text-paper py-section">
  <div class="container-site grid gap-10 lg:grid-cols-12 lg:items-end">
    <h2 class="display-xl lg:col-span-7">
      <span class="block">{text.ctaTitle[0]} </span>
      <span class="block font-semibold">{text.ctaTitle[1]}</span>
    </h2>
    <div class="grid gap-8 lg:col-span-5">
      <p class="text-paper/75">{text.ctaText}</p>
      <div class="flex flex-col gap-3 sm:flex-row">
        <Button
          href={localePath(locale, '/?interes=other#contacto')}
          variant="solid-light"
          arrow="next"
        >
          {text.talkToTech}
        </Button>
        <Button
          href={shopUrl(locale, 'search', system.shopQuery)}
          variant="outline-light"
          arrow="out"
        >
          {text.buySystem}
          <span class="sr-only"> {t(locale, 'nav.external')}</span>
        </Button>
      </div>
    </div>
  </div>
</section>
