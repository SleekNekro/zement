---
import Value from '../../ui/Value.astro';
import type { SystemPageText } from '../../../data/systemPage';
import type { LocalizedSystem } from '../../../lib/systems';

interface Props {
  system: LocalizedSystem;
  text: SystemPageText;
}

const { system, text } = Astro.props;
---

<!-- Preguntas frecuentes: <details> nativo, accesible y sin JavaScript. -->
<section
  id="preguntas"
  class="border-line py-section border-t"
>
  <div class="container-site grid gap-14 lg:grid-cols-12">
    <h2 class="display-lg text-navy lg:col-span-4">{text.faqTitle}</h2>
    <div class="border-navy border-t lg:col-span-7 lg:col-start-6">
      {system.faqs.map((faq) => (
        <details class="group border-line border-b">
          <summary class="text-navy flex min-h-16 cursor-pointer list-none items-center justify-between gap-6 py-5 [&::-webkit-details-marker]:hidden">
            <span class="display-md leading-snug">
              <Value text={faq.question} />
            </span>
            <span
              class="relative size-4 shrink-0"
              aria-hidden="true"
            >
              <span class="bg-navy absolute top-1/2 left-0 h-px w-4" />
              <span class="bg-navy absolute top-0 left-1/2 h-4 w-px transition-transform duration-(--zm-duration) group-open:rotate-90" />
            </span>
          </summary>
          <p class="text-muted max-w-2xl pb-6">
            <Value text={faq.answer} />
          </p>
        </details>
      ))}
    </div>
  </div>
</section>
