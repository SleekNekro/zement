---
import Arrow from '../../ui/Arrow.astro';
import Button from '../../ui/Button.astro';
import type { SystemPageText } from '../../../data/systemPage';
import { shopUrl } from '../../../lib/shop';
import { t, type Locale } from '../../../i18n/ui';

interface Props {
  locale: Locale;
  text: SystemPageText;
}

const { locale, text } = Astro.props;
---

<!--
  Profesionales: su ventaja (tarifa al iniciar sesión). Los dos enlaces van en una fila, a la altura
  del texto (alineados abajo con él).
-->
<section class="bg-navy text-paper">
  <div class="container-site grid gap-6 py-10 md:grid-cols-12 md:items-end md:py-12">
    <div class="md:col-span-5">
      <h2 class="display-md">{text.proTitle}</h2>
      <p class="text-paper/75 mt-3 max-w-lg">{text.proText}</p>
    </div>
    <div class="flex flex-wrap items-center gap-x-6 gap-y-2 md:col-span-7 md:flex-nowrap md:justify-end">
      <Button
        href={shopUrl(locale, 'login')}
        variant="solid-light"
        arrow="out"
      >
        {text.proCta}
        <span class="sr-only"> {t(locale, 'nav.external')}</span>
      </Button>
      <a
        class="link-arrow label text-sand hover:text-paper inline-flex min-h-11 items-center bg-none pb-0"
        href={shopUrl(locale, 'register')}
      >
        {text.proSignup}
        <span class="sr-only"> {t(locale, 'nav.external')}</span>
        <Arrow
          direction="out"
          class="btn-arrow"
        />
      </a>
    </div>
  </div>
</section>
