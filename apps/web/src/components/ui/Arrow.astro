---
/**
 * Flecha de trazo fino (1,25 px), dibujada en SVG.
 * - `out`: sale de la web (tienda).
 * - `down`: baja a una sección de esta página.
 * - `next`: avanza dentro del mismo contexto.
 */
export type ArrowDirection = 'out' | 'down' | 'next';

interface Props {
  direction?: ArrowDirection;
  class?: string;
}

const { direction = 'next', class: className } = Astro.props;
const paths: Record<ArrowDirection, string> = {
  out: 'M5 15 15 5M7 5h8v8',
  down: 'M10 3v14M4 11l6 6 6-6',
  next: 'M3 10h14M11 4l6 6-6 6',
};
---

<svg
  class:list={['size-[1.1em] shrink-0', className]}
  viewBox="0 0 20 20"
  fill="none"
  stroke="currentColor"
  stroke-width="1.25"
  stroke-linecap="square"
  aria-hidden="true"
  focusable="false"
  data-direction={direction}
>
  <path d={paths[direction]}></path>
</svg>
