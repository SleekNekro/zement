---
import type { HTMLAttributes } from 'astro/types';
import Arrow, { type ArrowDirection } from './Arrow.astro';

type Variant = 'solid-light' | 'outline-light' | 'solid-dark' | 'outline-dark';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  variant?: Variant;
  /** Flecha: `out` = abre la tienda, `down` = baja en la página, `next` = avanza. */
  arrow?: ArrowDirection | false;
}

const { href, variant = 'solid-dark', arrow = 'next', class: className, ...attrs } = Astro.props;
---

<a
  href={href}
  class:list={['btn', `btn-${variant}`, className]}
  {...attrs}
>
  <span>
    <slot />
  </span>
  {arrow && (
    <Arrow
      direction={arrow}
      class="btn-arrow"
    />
  )}
</a>
