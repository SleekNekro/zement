---
import { layerTextures, supportTexture } from './layerTextures';

/** Corte transversal de un sistema Zement (página del sistema): soporte + capas Z.01 → Z.04. */
interface Layer {
  code: string;
  name: string;
}

interface Props {
  layers: Layer[];
  label: string;
  supportLabel: string;
  thicknessLabel: string;
  class?: string;
}

const { layers, label, supportLabel, thicknessLabel, class: className } = Astro.props;
---

<div
  class:list={['layers border-navy flex flex-col-reverse border', className]}
  role="img"
  aria-label={`${label}: ${layers.map((layer) => layer.name).join(', ')}`}
>
  <!-- Soporte: la superficie existente sobre la que se aplica el sistema -->
  <div
    class:list={['relative flex items-end px-4 pb-2', supportTexture]}
    style="flex-grow: 1.3"
  >
    <span class="label text-night">{supportLabel}</span>
  </div>
  {layers.map((step, index) => (
    <div
      class="layer border-navy/40 relative isolate flex items-center justify-between gap-4 border-t px-4"
      style={`flex-grow: ${layerTextures[index]?.grow ?? 1}`}
    >
      <!-- Relleno con la textura de la capa -->
      <span
        class:list={['absolute inset-0 -z-10', layerTextures[index]?.texture]}
        aria-hidden="true"
      ></span>
      <span class="bg-paper/90 text-navy flex items-baseline gap-3 px-2 py-0.5">
        <span class="label">{step.code}</span>
        <span class="display text-base sm:text-lg lg:text-2xl">{step.name}</span>
      </span>
      <span class="label bg-paper/90 text-navy hidden px-2 py-0.5 sm:inline">{thicknessLabel}</span>
    </div>
  ))}
</div>
