---
/**
 * Corte transversal de un sistema Zement: soporte + capas Z.01 → Z.04, de abajo arriba.
 * - Modo animado (por defecto): cada capa se construye cuando su paso entra en pantalla
 *   (motion.ts enlaza `data-layer` con `data-layer-step`).
 * - Modo estático (`isStatic`): todas las capas visibles, sin depender del scroll.
 */
interface Layer {
  code: string;
  name: string;
}

interface Props {
  layers: Layer[];
  label: string;
  supportLabel: string;
  thicknessLabel: string;
  isStatic?: boolean;
  class?: string;
}

const {
  layers,
  label,
  supportLabel,
  thicknessLabel,
  isStatic = false,
  class: className,
} = Astro.props;

/*
 * Cada capa del corte: textura dibujada con la paleta de la marca y grosor relativo (flex-grow).
 * Los grosores son una representación visual, no medidas: las reales van en `thicknessTodo`.
 * Orden de abajo arriba: preparación → base → acabado → protección.
 */
const textures = [
  {
    grow: 1.1,
    texture:
      'bg-stone bg-[repeating-linear-gradient(135deg,color-mix(in_srgb,var(--zm-color-navy)_30%,transparent)_0_1px,transparent_1px_7px)]',
  },
  {
    grow: 2.2,
    texture:
      'bg-[color-mix(in_srgb,var(--zm-color-stone),var(--zm-color-navy)_9%)] bg-[radial-gradient(color-mix(in_srgb,var(--zm-color-navy)_45%,transparent)_1px,transparent_1.2px)] bg-[length:9px_9px]',
  },
  {
    grow: 1.4,
    texture:
      'bg-white bg-[radial-gradient(color-mix(in_srgb,var(--zm-color-navy-soft)_30%,transparent)_0.6px,transparent_0.8px)] bg-[length:5px_5px]',
  },
  {
    grow: 0.55,
    texture:
      'bg-white bg-[linear-gradient(100deg,transparent_20%,color-mix(in_srgb,var(--zm-color-white)_90%,transparent)_45%,transparent_70%),linear-gradient(var(--zm-color-white),var(--zm-color-stone))]',
  },
];
---

<div
  class:list={['layers border-navy flex flex-col-reverse border', className]}
  role="img"
  aria-label={`${label}: ${layers.map((layer) => layer.name).join(', ')}`}
>
  <!-- Soporte: la superficie existente sobre la que se aplica el sistema -->
  <div
    class="relative flex items-end bg-[color-mix(in_srgb,var(--zm-color-stone),var(--zm-color-navy)_28%)] bg-[repeating-linear-gradient(45deg,color-mix(in_srgb,var(--zm-color-night)_30%,transparent)_0_1px,transparent_1px_12px)] px-4 pb-2"
    style="flex-grow: 1.3"
  >
    <span class="label text-night">{supportLabel}</span>
  </div>
  {layers.map((step, index) => (
    <div
      class:list={[
        'layer border-navy/40 relative isolate flex items-center justify-between gap-4 border-t px-4',
        isStatic && 'is-built',
      ]}
      style={`flex-grow: ${textures[index]?.grow ?? 1}`}
      data-layer={isStatic ? undefined : index}
    >
      <!-- Relleno con la textura de la capa: es lo que se «aplica» al llegar a su paso -->
      <span
        class:list={['layer-fill absolute inset-0 -z-10', textures[index]?.texture]}
        aria-hidden="true"
      ></span>
      <span class="layer-label bg-paper/90 text-navy flex items-baseline gap-3 px-2 py-0.5">
        <span class="label">{step.code}</span>
        <span class="display text-base sm:text-lg lg:text-2xl">{step.name}</span>
      </span>
      <span class="layer-label label bg-paper/90 text-navy hidden px-2 py-0.5 sm:inline">
        {thicknessLabel}
      </span>
    </div>
  ))}
</div>
