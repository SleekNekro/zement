---
/**
 * Titular cuyas líneas suben desde una máscara al entrar en pantalla.
 * Cada elemento de `lines` es una línea visual.
 */
interface Props {
  lines: string[];
  as?: 'h1' | 'h2' | 'h3' | 'h4';
  class?: string;
  /** Índice de la línea que se muestra con más peso (énfasis). */
  emphasis?: number;
}

const { lines, as: Tag = 'h2', class: className, emphasis } = Astro.props;
---

<Tag
  class={className}
  data-reveal-lines
>
  {lines.map((line, index) => (
    <span
      class="reveal-line"
      style={`--line-index: ${index}`}
    >
      <span class:list={[index === emphasis && 'font-semibold']}>
        {line}
        {index < lines.length - 1 && ' '}
      </span>
    </span>
  ))}
</Tag>
