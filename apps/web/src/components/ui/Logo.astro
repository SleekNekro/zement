---
import ZementLogo from '@zement/design-tokens/brand/zement-logo.svg';

interface Props {
  /** Dominio junto al logotipo: «.com» en la web, «.shop» en la tienda. */
  suffix?: string;
  /**
   * Tamaño como clases de texto de Tailwind (p. ej. `text-xl md:text-[1.75rem]`): el logotipo mide
   * 1em de alto y el dominio va en proporción, en la misma línea base que «zement».
   */
  class?: string;
}

const { suffix, class: className } = Astro.props;
---

<span class:list={['inline-flex items-baseline gap-[0.07em] leading-none', className]}>
  <ZementLogo
    class="block h-[1em] w-auto shrink-0"
    aria-hidden="true"
  />
  {suffix && (
    <span class="-translate-y-[0.02em] text-[0.72em] font-light tracking-normal normal-case">
      {suffix}
    </span>
  )}
</span>
