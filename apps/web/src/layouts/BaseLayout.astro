---
import '../styles/global.css';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import ShopBar from '../components/layout/ShopBar.astro';
import { locales, localePath, ogLocales, type Locale } from '../i18n/locales';
import { isIndexable } from '../lib/seo';
import favicon from '@zement/design-tokens/brand/zement-favicon.svg?url';
import displayFont from '@zement/design-tokens/fonts/archivo-latin-wdth-normal.woff2?url';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Ruta sin prefijo de idioma, cuando es la misma en todos (p. ej. «/» de la 404). */
  path?: string;
  /** Rutas completas por idioma, cuando cada idioma tiene su propia URL (p. ej. /sistemas/ y /de/systeme/). */
  paths?: Record<Locale, string>;
  /** Fuera de buscadores aunque la web se publique (p. ej. borradores legales, 404). */
  noindex?: boolean;
}

const { locale, title, description, path = '/', paths, noindex = false } = Astro.props;
const alternates: Record<Locale, string> =
  paths ??
  (Object.fromEntries(locales.map((code) => [code, localePath(code, path)])) as Record<
    Locale,
    string
  >);
const site = Astro.site ?? new URL('http://localhost:4321');
const absolute = (route: string): string => new URL(route, site).href;
const canonical = absolute(alternates[locale]);
const robots = isIndexable && !noindex ? 'index, follow' : 'noindex, nofollow';
const ogImage = new URL('/og.png', site).href;
// Datos estructurados mínimos y verificables: nombre, web y logotipo (sin datos pendientes).
const organization = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Zement',
  url: new URL('/', site).href,
  logo: new URL('/apple-touch-icon.png', site).href,
});
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <title>{title}</title>
    <link
      rel="icon"
      href={favicon}
      type="image/svg+xml"
    />
    <link
      rel="apple-touch-icon"
      href="/apple-touch-icon.png"
    />
    <meta
      name="description"
      content={description}
    />
    <link
      rel="canonical"
      href={canonical}
    />
    {locales.map((code) => (
      <link
        rel="alternate"
        hreflang={code}
        href={absolute(alternates[code])}
      />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={absolute(alternates.es)}
    />
    <meta
      property="og:title"
      content={title}
    />
    <meta
      property="og:description"
      content={description}
    />
    <meta
      property="og:url"
      content={canonical}
    />
    <meta
      property="og:type"
      content="website"
    />
    <meta
      property="og:site_name"
      content="Zement"
    />
    <meta
      property="og:locale"
      content={ogLocales[locale]}
    />
    <meta
      property="og:image"
      content={ogImage}
    />
    <meta
      property="og:image:width"
      content="1200"
    />
    <meta
      property="og:image:height"
      content="630"
    />
    <meta
      property="og:image:alt"
      content="Zement"
    />
    <meta
      name="twitter:card"
      content="summary_large_image"
    />
    <meta
      name="robots"
      content={robots}
    />
    <script
      type="application/ld+json"
      is:inline
      set:html={organization}
    />
    <meta
      name="theme-color"
      content="#0f1c26"
    />
    <link
      rel="preload"
      href={displayFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body class="flex min-h-screen flex-col">
    <SiteHeader
      locale={locale}
      alternates={alternates}
    />
    <main
      id="contenido"
      class="flex-1"
    >
      <slot />
    </main>
    <SiteFooter locale={locale} />
    <ShopBar locale={locale} />
    <script src="../scripts/motion.ts"></script>
  </body>
</html>
