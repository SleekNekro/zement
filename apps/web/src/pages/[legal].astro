---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LegalPage from '../components/sections/legal/LegalPage.astro';
import { legalPages, legalPath } from '../lib/legal';

export async function getStaticPaths() {
  const entries = await getCollection('legal', (entry) => entry.data.lang === 'es');
  return entries.map((entry) => ({
    params: { legal: legalPages[entry.data.page].es },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'legal'>;
}

const { entry } = Astro.props;
---

<BaseLayout
  locale="es"
  title={`${entry.data.title} · Zement`}
  description={entry.data.description}
  paths={{ es: legalPath('es', entry.data.page), en: legalPath('en', entry.data.page) }}
>
  <LegalPage
    locale="es"
    entry={entry}
  />
</BaseLayout>
