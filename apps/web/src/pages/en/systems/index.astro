---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SystemsIndex from '../../../components/sections/system/SystemsIndex.astro';
import { systemsIndexText } from '../../../data/systemPage';
import { getSystems, systemsIndexPath } from '../../../lib/systems';

const systems = await getSystems('en');
const text = systemsIndexText.en;
---

<BaseLayout
  locale="en"
  title={`${text.title} · Zement`}
  description={text.intro}
  paths={{ es: systemsIndexPath('es'), en: systemsIndexPath('en') }}
>
  <SystemsIndex
    locale="en"
    systems={systems}
  />
</BaseLayout>
