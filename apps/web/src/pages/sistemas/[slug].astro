---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SystemPage from '../../components/sections/system/SystemPage.astro';
import { getSystems, isTodo, type LocalizedSystem } from '../../lib/systems';

export async function getStaticPaths() {
  const systems = await getSystems('es');
  return systems.map((system) => ({ params: { slug: system.slug }, props: { system } }));
}

interface Props {
  system: LocalizedSystem;
}

const { system } = Astro.props;
const description = isTodo(system.summary) ? system.name : system.summary;
---

<BaseLayout
  locale="es"
  title={`${system.name} · Zement`}
  description={description}
  paths={system.paths}
>
  <SystemPage
    locale="es"
    system={system}
  />
</BaseLayout>
