---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import { notFound } from '../data/notFound';
import { shopUrl } from '../lib/shop';

const es = notFound.es;
const en = notFound.en;
---

<BaseLayout
  locale="es"
  title="404 · Zement"
  description={es.text}
  noindex
>
  <section class="surface-microcement-light border-line border-b">
    <div class="container-site pt-36 pb-16 md:pb-24">
      <p
        class="display text-navy/15 text-[clamp(7rem,24vw,18rem)] leading-[0.8] font-semibold select-none"
        aria-hidden="true"
      >
        404
      </p>
      <div class="mt-10 grid gap-10 md:grid-cols-12 md:items-end">
        <div class="md:col-span-7">
          <h1 class="display-lg text-navy">{es.title}</h1>
          <p class="text-muted mt-5 max-w-md">{es.text}</p>
          <div class="mt-10 flex flex-wrap gap-3">
            <Button
              href="/"
              variant="solid-dark"
              arrow="next"
            >
              {es.home}
            </Button>
            <Button
              href={shopUrl('es')}
              variant="outline-dark"
              arrow="out"
            >
              {es.shop}
            </Button>
          </div>
        </div>
        <!-- Versión en inglés para el resto de idiomas: el servidor no sabe en cuál estaba el visitante -->
        <div
          class="border-line md:col-span-4 md:col-start-9 md:self-end md:border-l md:pl-8"
          lang="en"
        >
          <p class="text-navy">{en.title}</p>
          <p class="text-muted mt-2 text-sm">{en.text}</p>
          <p class="mt-4 flex flex-wrap gap-x-6 gap-y-3">
            <a
              class="link-arrow label text-navy"
              href="/en/"
            >
              {en.home}
            </a>
            <a
              class="link-arrow label text-navy"
              href={shopUrl('en')}
            >
              {en.shop}
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
