# URL pública de la tienda PrestaShop (en local, el contenedor Docker).
PUBLIC_TIENDA_URL=http://localhost:8090

# Clave pública de Cloudflare Turnstile. En local, la clave oficial de prueba que siempre acepta:
# 1x00000000000000000000AA (nunca en la web pública).
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
