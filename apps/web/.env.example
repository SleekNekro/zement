# URL pública de la tienda PrestaShop (en local, el contenedor Docker).
PUBLIC_TIENDA_URL=http://localhost:8090

# Clave pública de Cloudflare Turnstile. El widget se crea en Cloudflare con el modo «Invisible»
# (Turnstile → Add widget → Widget Mode: Invisible) y el formulario no muestra ninguna casilla.
# En local, la clave oficial de prueba invisible que siempre acepta (nunca en la web pública):
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000BB

# Google Analytics 4 («G-…»). Solo se carga si el visitante acepta la analítica en el aviso de
# cookies (packages/consent). Vacío = no se carga nada de Google. TODO: identificador de Zement.
PUBLIC_GA4_ID=
