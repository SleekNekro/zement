---
import { shopUrl, t, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const loginPath = locale === 'es' ? 'iniciar-sesion' : 'login';
---

<section class="bg-cream py-section">
  <div class="container-site grid gap-8">
    <p class="todo w-fit">TODO: contenido real — titular y claim de marca</p>
    <h1 class="max-w-3xl text-4xl md:text-6xl">Zement</h1>
    <p class="todo w-fit">TODO: contenido real — texto de presentación de la empresa</p>
    <a
      class="w-fit rounded bg-navy px-6 py-3 text-cream no-underline hover:bg-navy-dark"
      href={shopUrl(locale)}
    >
      {t(locale, 'home.shopCta')}
    </a>
  </div>
</section>

<section
  id="productos"
  class="py-section"
>
  <div class="container-site grid gap-6">
    <h2 class="text-3xl">{t(locale, 'nav.products')}</h2>
    <p class="todo w-fit">
      TODO: contenido real — familias de producto (se enlazarán con la tienda por referencia)
    </p>
  </div>
</section>

<section
  id="profesionales"
  class="border-y border-line py-section"
>
  <div class="container-site grid gap-4">
    <h2 class="text-3xl">{t(locale, 'home.proTitle')}</h2>
    <p class="max-w-2xl text-muted">{t(locale, 'home.proText')}</p>
    <a
      class="w-fit rounded border border-navy px-6 py-3 text-navy no-underline hover:bg-navy hover:text-cream"
      href={shopUrl(locale, loginPath)}
    >
      {t(locale, 'home.proCta')}
    </a>
  </div>
</section>
