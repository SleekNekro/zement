---
import { t, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="mt-section bg-navy-dark text-cream/90">
  <div class="container-site flex flex-col gap-4 py-10 text-sm md:flex-row md:justify-between">
    <p>
      © {year} Zement. {t(locale, 'footer.rights')}
    </p>
    <ul class="flex gap-5">
      <li>
        <span class="todo">TODO: {t(locale, 'footer.legal')}</span>
      </li>
      <li>
        <span class="todo">TODO: {t(locale, 'footer.privacy')}</span>
      </li>
      <li>
        <span class="todo">TODO: {t(locale, 'footer.cookies')}</span>
      </li>
    </ul>
  </div>
</footer>
